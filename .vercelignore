# Vercel ignore file
# Files and directories to ignore during deployment

# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/

# Environment files
.env
.env.local
.env.production.local
.env.development.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# TypeScript build cache
*.tsbuildinfo

# Vercel local metadata
.vercel

# Git metadata
.git/
.gitignore

# Optional documentation exclusion
# README.md
