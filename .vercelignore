# Vercel ignore file
# Files and directories to ignore during deployment

# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/

# Environment files
.env
.env.local
.env.production.local
.env.development.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# TypeScript
*.tsbuildinfo

# Vercel
.vercel

# Git
.git/
.gitignore

# README (optional - keep if you want it in deployment)
# README.md

# Config files that shouldn't be in production
tailwind.config.ts
postcss.config.js
tsconfig.json
next.config.js
package.json
package-lock.json